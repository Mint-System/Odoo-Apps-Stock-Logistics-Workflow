<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">stock_move_lot_quantity_mrp.mrp_production_form_view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Add decoration and invisible field to the move_raw_ids tree -->
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='lot_ids']" position="replace">
                <field name="lot_badges_html"
                       widget="html"
                       string="Lot/Serial Numbers"
                       groups="stock.group_production_lot"
                       readonly="1"
                       column_invisible="not parent.show_lot_ids or parent.state == 'draft'"
                       invisible="not show_details_visible"/>
            </xpath>

        </field>
    </record>
</odoo>
