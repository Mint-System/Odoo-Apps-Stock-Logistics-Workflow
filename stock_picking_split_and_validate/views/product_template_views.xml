<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">stock_picking_remove.product_template_form_view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">      
            <xpath expr="//group[@name='group_lots_and_weight']" position="after">
                <group name="picking" string="Picking">
                    <field name="pick_and_validate_automatically" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
