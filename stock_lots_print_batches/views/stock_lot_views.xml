<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="stock_lot_action_print_labels_batch_wizard" model="ir.actions.act_window">
        <field name="name">Download Serial Labels in Batches</field>
        <field name="res_model">print.serial.labels.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="server_action_print_serial_labels_wizard" model="ir.actions.server">
        <field name="name">Download Labels in Batches</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="state">code</field>
        <field name="code">
action = env.ref('stock_lots_print_batches.action_print_serial_labels_wizard').read()[0]
action['context'] = {'active_ids': env.context.get('active_ids')}
action['target'] = 'new'
        </field>
    </record>

</odoo>