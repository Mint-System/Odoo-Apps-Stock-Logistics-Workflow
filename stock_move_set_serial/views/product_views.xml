<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_product_form_inherit_serial" model="ir.ui.view">
    <field name="name">product.form.serial.prefix</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='tracking']" position="after">
            <group invisible="tracking == 'none'">
                <field name="serial_prefix"/>
            </group>
        </xpath>
    </field>
  </record>
</odoo>
