<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="stock_critical_forecast.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="before">
            <t t-set-slot="control-panel-status-indicator">
                <span t-if="lastUpdated" class="text-muted small ms-2">
                    Last Updated On: <t t-esc="lastUpdated"/>
                </span>
            </t>
        </xpath>
    </t>
</templates>
